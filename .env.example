DB_HOST=localhost
DB_PORT=3306
DB_USER=user
DB_PASSWORD=password
DB_NAME=npazs

MODX_SSH_HOST=localhost
MODX_SSH_PORT=22
MODX_SSH_USERNAME=user
MODX_SSH_PASSWORD=password
MODX_BASE_PATH=/var/www/html

OLLAMA_DEFAULT_MODEL=gpt-oss:20b
OLLAMA_BASE_URL=http://localhost:11434

# --- LLM-бэкенды ---
# Выбор активного бэкенда (по умолчанию free_deepseek — локальный прокси):
#   ollama, kilo_gateway, cline, openrouter, cerebras, mistral, gemini,
#   free_deepseek, qwen2api
LLM_BACKEND=ollama

# Kilo Gateway (https://kilo.ai)
KILO_GATEWAY_API_KEY=
KILO_GATEWAY_BASE_URL=https://api.kilo.ai/api/gateway
KILO_GATEWAY_DEFAULT_MODEL=anthropic/claude-sonnet-4.5

# Cline API (https://app.cline.bot) — загружаются только free-модели (суффикс ':free');
# 'openrouter/free' — авто-роутер по free-моделям
CLINE_API_KEY=
CLINE_BASE_URL=https://api.cline.bot/api/v1
CLINE_DEFAULT_MODEL=openrouter/free

# OpenRouter (https://openrouter.ai) — free-модели с суффиксом :free
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=openrouter/free

# Cerebras (https://cerebras.ai) — платный pay-per-token, но с generous free tier'ом
# при регистрации (без карты), контекст до 128K
CEREBRAS_API_KEY=
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
CEREBRAS_DEFAULT_MODEL=llama3.1-8b

# Mistral AI (https://mistral.ai) — платный pay-per-token, но с free tier'ом при
# регистрации (без карты), контекст до 128K
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1
MISTRAL_DEFAULT_MODEL=mistral-large-latest

# Google Gemini (https://ai.google.dev) — 1500 запросов/день на free-тарифе
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_DEFAULT_MODEL=gemini-2.5-flash

# FreeDeepseekAPI (https://github.com/dekrezz/FreeDeepseekAPI) — локальный
# OpenAI-совместимый прокси поверх web-сессии chat.deepseek.com.
# Запуск в каталоге прокси: `npm run auth` (один раз: логин/импорт сессии),
# затем `npm start` (по умолчанию http://127.0.0.1:9655).
FREE_DEEPSEEK_BASE_URL=http://127.0.0.1:9655
FREE_DEEPSEEK_DEFAULT_MODEL=deepseek-v4-flash
FREE_DEEPSEEK_SESSION=npazs-main

# Qwen2API / Qwen-Proxy (https://github.com/Rfym21/Qwen2API) — локальный
# OpenAI-совместимый прокси поверх аккаунтов chat.qwen.ai.
# Установка: `python scripts/setup_qwen2api.py` (или `make setup-qwen2api`).
# Запуск: `bun src/server.js` (или npm start) в каталоге прокси
# (по умолчанию http://127.0.0.1:3000; порт — SERVICE_PORT в .env прокси).
# API_KEY прокси ОБЯЗАТЕЛЕН (env API_KEY в .env прокси) — продублируйте его
# в QWEN2API_API_KEY. Аккаунты chat.qwen.ai добавляются через веб-панель
# прокси (http://127.0.0.1:3000) или переменную ACCOUNTS.
QWEN2API_API_KEY=sk-123456
QWEN2API_BASE_URL=http://127.0.0.1:3000
QWEN2API_DEFAULT_MODEL=Qwen 3.8 Max (vision)

# --- TLS/SSL ---
# Если антивирус (Kaspersky/Dr.Web/ESET) или корпоративный прокси проверяет
# защищённые соединения, часть HTTPS-запросов падает с ошибкой самоподписанного
# сертификата: прокси Qwen2API отвечает HTTP 500 {"error":"无法创建或续接 Qwen 会话"}
# («qwen2api ошибка (попытка 1/5)» в NPA-ZS).
#   * Node/bun (прокси Qwen2API/FreeDeepseekAPI): запускайте прокси через
#     scripts\qwen-proxy.bat, scripts\fd-proxy.bat или `make run-qwen2api` —
#     launcher подставит NODE_EXTRA_CA_CERTS с корнями Windows.
#   * NPA-ZS (python requests): укажите бандл корней или отключите проверку.
# Бандл создаётся скриптом scripts/export_system_ca.ps1 автоматически.
# REQUESTS_CA_BUNDLE=data/work_tools/ssl/system-ca-bundle.pem
# SSL_VERIFY=false            # крайняя мера: отключает проверку сертификатов
# NPAZ_DISABLE_SSL_VERIFY=1   # то же для загрузки списков моделей в GUI


