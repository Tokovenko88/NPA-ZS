DB_HOST=localhost
DB_PORT=3306
DB_USER=user
DB_PASSWORD=password
DB_NAME=npazs

MODX_SSH_HOST=localhost
MODX_SSH_PORT=22
MODX_SSH_USERNAME=user
MODX_SSH_PASSWORD=password
MODX_BASE_PATH=/var/www/html

OLLAMA_DEFAULT_MODEL=gemini-1.5-flash
OLLAMA_BASE_URL=http://localhost:11434

# --- LLM-бэкенды ---
# Выбор активного бэкенда (по умолчанию kilo_gateway):
#   ollama, kilo_gateway, cline, openrouter, deepseek, gemini
LLM_BACKEND=kilo_gateway

# Kilo Gateway (https://kilo.ai)
KILO_GATEWAY_API_KEY=
KILO_GATEWAY_BASE_URL=https://api.kilo.ai/api/gateway
KILO_GATEWAY_DEFAULT_MODEL=anthropic/claude-sonnet-4.5

# Cline API (https://app.cline.bot) — бесплатная модель minimax/minimax-m2.5
CLINE_API_KEY=
CLINE_BASE_URL=https://api.cline.bot/api/v1
CLINE_DEFAULT_MODEL=minimax/minimax-m2.5

# OpenRouter (https://openrouter.ai) — free-модели с суффиксом :free
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=openrouter/free

# DeepSeek (https://platform.deepseek.com) — 10М токенов/месяц бесплатно
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_DEFAULT_MODEL=deepseek-chat

# Google Gemini (https://ai.google.dev) — 1500 запросов/день на free-тарифе
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_DEFAULT_MODEL=gemini-2.0-flash
