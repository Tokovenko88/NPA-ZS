DB_HOST=localhost
DB_PORT=3306
DB_USER=user
DB_PASSWORD=password
DB_NAME=npazs

MODX_SSH_HOST=localhost
MODX_SSH_PORT=22
MODX_SSH_USERNAME=user
MODX_SSH_PASSWORD=password
MODX_BASE_PATH=/var/www/html

OLLAMA_DEFAULT_MODEL=gemini-1.5-flash
OLLAMA_BASE_URL=http://localhost:11434

# --- LLM-бэкенды ---
# Выбор активного бэкенда (по умолчанию free_deepseek — локальный прокси):
#   ollama, kilo_gateway, cline, openrouter, cerebras, together, mistral, gemini,
#   free_deepseek
LLM_BACKEND=free_deepseek

# Kilo Gateway (https://kilo.ai)
KILO_GATEWAY_API_KEY=
KILO_GATEWAY_BASE_URL=https://api.kilo.ai/api/gateway
KILO_GATEWAY_DEFAULT_MODEL=anthropic/claude-sonnet-4.5

# Cline API (https://app.cline.bot) — загружаются только free-модели (суффикс ':free');
# 'openrouter/free' — авто-роутер по free-моделям
CLINE_API_KEY=
CLINE_BASE_URL=https://api.cline.bot/api/v1
CLINE_DEFAULT_MODEL=openrouter/free

# OpenRouter (https://openrouter.ai) — free-модели с суффиксом :free
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=openrouter/free

# Cerebras (https://cerebras.ai) — платный pay-per-token, но с generous free tier'ом
# при регистрации (без карты), контекст до 128K
CEREBRAS_API_KEY=
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
CEREBRAS_DEFAULT_MODEL=llama3.1-8b

# Together AI (https://together.ai) — платный pay-per-token, но с free tier'ом при
# регистрации (без карты), контекст до 128K
TOGETHER_API_KEY=
TOGETHER_BASE_URL=https://api.together.xyz/v1
TOGETHER_DEFAULT_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo

# Mistral AI (https://mistral.ai) — платный pay-per-token, но с free tier'ом при
# регистрации (без карты), контекст до 128K
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1
MISTRAL_DEFAULT_MODEL=mistral-large-latest

# Google Gemini (https://ai.google.dev) — 1500 запросов/день на free-тарифе
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_DEFAULT_MODEL=gemini-2.5-flash

# FreeDeepseekAPI (https://github.com/dekrezz/FreeDeepseekAPI) — локальный
# OpenAI-совместимый прокси поверх web-сессии chat.deepseek.com.
# Запуск в каталоге прокси: `npm run auth` (один раз: логин/импорт сессии),
# затем `npm start` (по умолчанию http://127.0.0.1:9655).
# PROXY_API_KEY опционален: если задан в прокси, продублируйте его в
# FREE_DEEPSEEK_API_KEY. FREE_DEEPSEEK_SESSION — sticky-сессия агента
# (заголовок x-agent-session; у каждого параллельного клиента своя).
FREE_DEEPSEEK_API_KEY=
FREE_DEEPSEEK_BASE_URL=http://127.0.0.1:9655/v1
FREE_DEEPSEEK_DEFAULT_MODEL=deepseek-v4-flash
FREE_DEEPSEEK_SESSION=npazs-main

# --- Пост-анализ: независимый провайдер ---
# Может отличаться от основного (LLM_BACKEND): например, основной прогон на
# OpenRouter, а пост-анализ на Gemini. Без POST_ANALYSIS_BACKEND —
# используется основной бэкенд (по умолчанию тоже free_deepseek).
#   ollama, kilo_gateway, cline, openrouter, cerebras, together, mistral, gemini,
#   free_deepseek
POST_ANALYSIS_BACKEND=
POST_ANALYSIS_MODEL=
# Отдельные креды пост-анализа (редакторы «API URL (пост)» / «API Key (пост)»
# в GUI ревизии). Непустые значения имеют приоритет над ключом/URL самого
# пост-бэкенда — так пост-анализ может работать, например, на другом инстансе
# прокси FreeDeepseekAPI. Пусто — наследовать креды пост-бэкенда.
POST_ANALYSIS_API_KEY=
POST_ANALYSIS_BASE_URL=
