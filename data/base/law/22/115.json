            {
              "body": [
                {
                  "type": "paragraph",
                  "html_text": "<p class=\"justifyleft\">в статье 1:</p>",
                  "order": 1
                },
                {
                  "type": "child_ref",
                  "item_id": "1675_article_1_point_1_subpoint_а",
                  "order": 2
                },
                {
