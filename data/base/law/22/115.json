  "head_revision": [
    {
      "npa_head": "О внесении изменений в Законы города Севастополя от 03 июня 2014 года № 22-ЗС «О денежном содержании государственных гражданских служащих города Севастополя» и № 23-ЗС «О государственной гражданской службе города Севастополя»"
    }
  ],
  "npa_items_revision": [
    {
