      "revisions": [
        {
          "body": [
            {
              "type": "paragraph",
              "html_text": "<p class=\"justifyleft\">Внести в Закон города Севастополя от 03 июня 2014 года <a href=\"view/laws/bank/iyun_2014/o_denezhnom_soderzhanii_gosudarstvennyh_grazhdanskih_sluzhashhih_goroda_sevastopolya/\">№ 22-ЗС</a> «О денежном содержании государственных гражданских служащих города Севастополя» («Севастопольские известия», №49-50(1671) от 07.06.2014) следующие изменения:</p>",
              "order": 1
            },
            {
              "type": "child_ref",
              "item_id": "1675_article_1_point_1",
