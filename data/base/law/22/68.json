              "order": 2
            },
            {
              "type": "paragraph",
              "html_text": "<p>после строки</p>",
              "order": 3
            },
            {
              "type": "paragraph",
              "html_text": "<p>«</p>",
              "order": 4
            },
            {
              "type": "paragraph",
              "html_text": "<table border=\"1\" cellpadding=\"0\" cellspacing=\"0\">\n<tbody>\n<tr>\n<td valign=\"top\" width=\"638\">\n<p align=\"center\">Ведущая группа должностей</p>\n</td>\n</tr>\n</tbody>\n</table>",
              "order": 5
