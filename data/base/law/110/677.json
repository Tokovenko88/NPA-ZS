      "item_children": [
        {
          "item_id": "93188_article_2_part_1",
          "item_type": "part",
          "item_number": "1",
          "item_level": 2,
          "revisions": [
            {
              "body": [
                {
                  "type": "paragraph",
                  "html_text": "<p class=\"consplusnormal\">Настоящий Закон вступает в силу со дня его официального опубликования, за исключением подпунктов «е» и «ж» пункта 2 статьи 1 настоящего Закона.</p>",
                  "order": 1
                }
              ]
            }
          ]
        },
        {
          "item_id": "93188_article_2_part_2",
          "item_type": "part",
          "item_number": "2",
          "item_level": 2,
          "revisions": [
            {
              "body": [
                {
                  "type": "paragraph",
                  "html_text": "<p class=\"consplusnormal\">Подпункты «е» и «ж» пункта 2 статьи 1 настоящего Закона вступают в силу с 1 января 2023 года.</p>",
                  "order": 1
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}