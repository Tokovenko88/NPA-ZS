                  "body": [
                    {
                      "type": "paragraph",
                      "html_text": "<p class=\"justifyfull\">часть 1 признать утратившей силу;</p>",
                      "order": 1
                    }
                  ]
                }
              ]
            },
            {
              "item_id": "93188_article_1_point_2_subpoint_б",
