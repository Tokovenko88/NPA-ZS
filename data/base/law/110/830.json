              "revisions": [
                {
                  "body": [
                    {
                      "type": "paragraph",
                      "html_text": "<p class=\"justifyfull\">в абзаце первом слова «2023 и 2024» заменить цифрами «2023–2025»;</p>",
                      "order": 1
                    }
                  ]
                }
              ]
            },
            {
              "item_id": "130223_article_1_point_1_subpoint_б",
              "item_type": "subpoint",
              "item_number": "б)",
              "item_level": 3,
              "revisions": [
                {
                  "body": [
                    {
                      "type": "paragraph",
                      "html_text": "<p class=\"justifyfull\">в пункте 1 слова «в пунктах 2 и 2.1» заменить словами «в пункте 2»;</p>",
                      "order": 1
                    }
                  ]
                }
              ]
            },
            {
              "item_id": "130223_article_1_point_1_subpoint_в",
              "item_type": "subpoint",
              "item_number": "в)",
              "item_level": 3,
              "revisions": [
                {
                  "body": [
                    {
                      "type": "paragraph",
                      "html_text": "<p class=\"justifyfull\">пункт 2.1 признать утратившим силу;</p>",
                      "order": 1
                    }
                  ]
                }
              ]
            },
            {
              "item_id": "130223_article_1_point_1_subpoint_г",
              "item_type": "subpoint",
              "item_number": "г)",
              "item_level": 3,
              "revisions": [
                {
                  "body": [
                    {
                      "type": "paragraph",
                      "html_text": "<p class=\"justifyfull\">в пункте 3 слова «в пункте 4 настоящей части и» исключить;</p>",
                      "order": 1
                    }
                  ]
                }
              ]
            },
            {
              "item_id": "130223_article_1_point_1_subpoint_д",
              "item_type": "subpoint",
